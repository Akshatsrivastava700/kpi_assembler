# Copy to .env and fill in values. Do not commit .env.

# gemini or ollama
KPI_LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key
KPI_GEMINI_MODEL=gemini-2.0-flash

# Optional override. Leave blank to use the default Gemini REST endpoint.
# KPI_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# Local fallback
# KPI_LLM_PROVIDER=ollama
# KPI_OLLAMA_MODEL=llama3.2:3b
# KPI_OLLAMA_URL=http://localhost:11434/api/generate

# KPI_USE_LLM=false
